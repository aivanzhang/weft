+def timing_oracles():
+    times, values = np.array([1., 2.]), np.array([[10.], [20.]])
+    queries, wanted = [-1., 1., 1.5, 2., 3.], [10., 10., 10., 20., 20.]
+    actual = [float(step_sample(times, values, time)[0]) for time in queries]
+    check(actual == wanted, 'STEP boundary oracle')
+    check(np.array_equal(np.array([24, 48])/24, [1., 2.]), 'Frame-to-time oracle')
+    return {'step_times': times.tolist(), 'step_values': values.ravel().tolist(),
