{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weft",
  "account_id": "73c2bbd14f7b9025d9fd9eb56ad54609",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  // "/" is served straight from the asset bundle as index.html; only the API and health
  // endpoints need the Worker ahead of assets.
  "assets": {"directory": ".build/public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health", "/demo"]},
  "vars": {"PUBLIC_ORIGIN": "https://weft.ivanzhangofficial.workers.dev", "SUBMISSIONS_ENABLED": "true", "RELEASE": "exercise-pipeline-20261104"},
  // Served on the account's workers.dev subdomain rather than a kintsugi.software custom
  // domain, at the user's request. The Cloudflare account is unchanged; only the hostname is.

  "r2_buckets": [{"binding": "UPLOADS", "bucket_name": "weft-private-submissions"}],
  "durable_objects": {"bindings": [{"name": "GENERATOR", "class_name": "GenerationContainer"}, {"name": "SUBMISSIONS", "class_name": "SubmissionQueue"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GenerationContainer", "SubmissionQueue"]}],
  // standard-4 (4 vCPU) because the learning and appearance stages run concurrently and each
  // needs its own pair. On two vCPU they contended and the lab's internal 120-second
  // learning budget tripped on clips that had completed sequentially; with four, both of
  // those clips complete and the appearance stage costs nothing. CPU bills by active use, so
  // the extra cores are near-free and the shorter run offsets the larger memory footprint.
  "containers": [{"class_name": "GenerationContainer", "image": "./Dockerfile", "image_build_context": "..", "instance_type": "standard-4", "max_instances": 1, "rollout_active_grace_period": 240}],
  "limits": {"cpu_ms": 1000},
  "observability": {"enabled": false}
}
